# Servicio systemd de USUARIO para DESARROLLO (no requiere sudo).
# Producción se instala con homeserver/services/nosotros/deploy.sh.
# Instalación (en tu PC de desarrollo, ajustá la ruta si cambia):
#   mkdir -p ~/.config/systemd/user
#   cp nosotros.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now nosotros
#   loginctl enable-linger $USER   # para que arranque sin iniciar sesión
#
# Logs: journalctl --user -u nosotros -f

[Unit]
Description=Nosotros (PocketBase)
After=network-online.target

[Service]
WorkingDirectory=%h/Projects/SJ/server
# Clave compartida con el servicio de avisos (NOS-37). El "-": sin ese archivo arranca igual, sin avisos.
EnvironmentFile=-%h/Projects/SJ/avisos/.env
# Solo local: es la instancia de desarrollo (Vite la usa vía proxy en 127.0.0.1).
# Producción vive en el servidor (repo homeserver), no acá.
ExecStart=%h/Projects/SJ/server/pocketbase serve --http 127.0.0.1:8090
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
